{
  "name": "moon-bounce",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Moon Bounce: Solar System Adventure — a gentle, autism- and toddler-friendly 2.5D space platformer.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:single": "tsc && vite build && node scripts/build-single.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "playtest": "node scripts/playtest.mjs"
  },
  "dependencies": {
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "playwright": "^1.61.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^4.1.9"
  }
}
